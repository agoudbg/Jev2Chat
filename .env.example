# Copy to .env.local. Never add a NEXT_PUBLIC_ prefix to credentials.
JEV_PUBLIC_ENABLED=false
JEV_PUBLIC_TOKEN=
JEV_PUBLIC_MODEL=jev-latest
JEV_PUBLIC_BASE_URL=https://api.typesafe.ai

# Exact origins managed by the operator. No wildcard or arbitrary URL proxy.
JEV_ALLOWED_API_ORIGINS=https://api.typesafe.ai
JEV_ALLOW_HTTP_UPSTREAM=false
JEV_BODY_MAX_BYTES=262144
JEV_UPSTREAM_TIMEOUT_MS=30000

# Public mode requires shared Upstash Redis and a random >=32-character secret.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
JEV_LIMITER_SECRET=
JEV_PUBLIC_MAX_ROUNDS=64
JEV_PUBLIC_MAX_RETRIES=1
JEV_PUBLIC_MAX_INPUT_CHARS=16000
JEV_RATE_WINDOW_SECONDS=60
JEV_RATE_REQUESTS=30
JEV_RUNS_PER_WINDOW=5
JEV_IP_CONCURRENCY=1
JEV_GLOBAL_CONCURRENCY=8
JEV_GLOBAL_DAILY_REQUESTS=1000

# shared: every visitor shares one bucket; no forwarded IP headers are trusted.
# trusted-proxy: the edge must strip client headers and inject the secret + one IP.
JEV_IP_MODE=shared
JEV_CLIENT_IP_HEADER=x-real-ip
JEV_TRUSTED_PROXY_SECRET=
